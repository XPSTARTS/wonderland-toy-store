{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=wonderland;Username=postgres;Password=yourpass"
  },
  "Jwt": {
    "Key": "YOUR_JWT_KEY_HERE",
    "Issuer": "wonderland-backend",
    "Audience": "wonderland-frontend",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "SendGrid": {
    "ApiKey": "YOUR_SENDGRID_API_KEY_HERE"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "your-email@gmail.com",
    "SmtpPassword": "your-app-password",
    "FromEmail": "noreply@wonderland.com",
    "AdminEmail": "your-admin-email@gmail.com"
  }
}